{
  "openapi": "3.0.3",
  "info": {
    "title": "GitHub runtime releases",
    "version": "1.0.0",
    "description": "Narrow contract for public release endpoints used by Irori. Examples captured from GitHub; no authentication or user data."
  },
  "servers": [
    {
      "url": "https://api.github.com"
    }
  ],
  "paths": {
    "/repos/Heroic-Games-Launcher/wine-crossover/releases": {
      "get": {
        "summary": "List public releases",
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public GitHub release response captured 2026-10-25; fields consumed by Irori",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "example": [
                  {
                    "tag_name": "23.7.1-1",
                    "draft": false,
                    "prerelease": false,
                    "published_at": "2026-04-17T22:26:17Z",
                    "html_url": "https://github.com/Heroic-Games-Launcher/wine-crossover/releases/tag/23.7.1-1",
                    "assets": [
                      {
                        "name": "Wine-Crossover-23.7.1-1.tar.xz",
                        "size": 200466784,
                        "browser_download_url": "https://github.com/Heroic-Games-Launcher/wine-crossover/releases/download/23.7.1-1/Wine-Crossover-23.7.1-1.tar.xz"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "example": {
                  "message": "API rate limit exceeded"
                }
              }
            }
          }
        }
      }
    },
